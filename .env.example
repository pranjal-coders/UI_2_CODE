# UI2Code Configuration
# Copy this file to .env and fill in your values if needed

# Vision Provider:
# "local_cv" : 100% FREE & OFFLINE Computer Vision engine using OpenCV & Pillow (DEFAULT).
#              Dynamically extracts layout, cards, buttons, sections & sampled colors from ANY screenshot!
# "fixture"  : Static TechFlow fixture demo mode.
# "gemini"   : Google Gemini Multimodal Vision API (100% FREE tier available at https://aistudio.google.com/apikey).
# "openai"   : OpenAI GPT-4o Vision API (requires paid key).
VISION_PROVIDER=local_cv

# Google Gemini API Key (OPTIONAL — free tier from https://aistudio.google.com/apikey with 15 RPM / 1500 RPD)
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (OPTIONAL)
# OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
